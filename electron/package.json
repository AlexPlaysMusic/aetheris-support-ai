{
  "name": "aetheris-ai-desktop-shell",
  "version": "1.0.0",
  "description": "Aetheris AI desktop application shell.",
  "author": "Aetheris",
  "main": "main.cjs",
  "private": true,
  "build": {
    "electronVersion": "45.1.0",
    "appId": "me.aetherisai.computer",
    "productName": "Aetheris AI",
    "directories": {
      "output": "../release-installer",
      "buildResources": "assets"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "artifactName": "Aetheris-AI-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "protocols": [
      {
        "name": "Aetheris sign-in",
        "schemes": [
          "aetheris"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aetheris AI",
      "deleteAppDataOnUninstall": false
    }
  }
}
