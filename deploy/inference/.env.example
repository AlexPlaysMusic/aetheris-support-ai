# Select a model whose license, VRAM needs, and intended use you have reviewed.
AETHERIS_UPSTREAM_MODEL=organization/model-name
AETHERIS_UPSTREAM_MODEL_ID=organization/model-name

# Generate a long random value. Set the same value as
# AETHERIS_INFERENCE_API_KEY in the Vercel environment.
AETHERIS_INFERENCE_API_KEY=replace-with-a-random-secret

# Optional Hugging Face token for gated model downloads.
HF_TOKEN=
