# Aetheris-owned API and private model inference credentials.
AETHERIS_API_RATE_LIMIT_PER_MINUTE=60
AETHERIS_INFERENCE_BASE_URL=https://inference.example.com/v1
AETHERIS_INFERENCE_API_KEY=
AETHERIS_INFERENCE_TIMEOUT_MS=55000
AETHERIS_MODELS_JSON=[]

# Temporary website chat inference (server-only; not Google OAuth).
GOOGLE_GENERATIVE_AI_API_KEY=

# Google OAuth is only for account sign-in.
GOOGLE_CLIENT_ID=paste-your-client-id-here
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=https://www.aetherisai.me

# Redis for server-side credits, API key hashes, rate limits, and auth.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email sign-in and support delivery.
RESEND_API_KEY=

# Optional billing providers. PayPal browser client ID is public by design.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
