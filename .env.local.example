# ------------------------------------------------------------------
# Aetheris LLM wiring. Default provider is your CUSTOM REST endpoint.
# Set LLM_PROVIDER=openai to use OpenAI instead.
# ------------------------------------------------------------------

# Which backend the chat route uses: "demo" (default, zero config),
# "gemini" (Google AI Studio key), "custom" (your REST endpoint) or "openai"
LLM_PROVIDER=demo

# Full URL your server accepts POSTs at, e.g.:
#   https://llm.example.com/v1/chat/completions
#   https://your-gateway.com/api/chat
#   http://localhost:11434/v1/chat/completions   (local dev)
CUSTOM_API_URL=https://your-llm-server.com/v1/chat/completions

# Auth for your endpoint. Header name + scheme are configurable:
#   Authorization: Bearer <key>   (default, OpenAI-style)
#   X-API-Key: <key>              (set CUSTOM_API_AUTH_HEADER=X-API-Key
#                                  and CUSTOM_API_AUTH_SCHEME= empty)
# Leave CUSTOM_API_KEY empty if your endpoint needs no auth (local dev).
CUSTOM_API_KEY=
CUSTOM_API_AUTH_HEADER=Authorization
CUSTOM_API_AUTH_SCHEME=Bearer

# Model IDs sent as "model" in the POST body.
# Map to whatever your server expects. The UI switcher sends
# "aetheris-basic" | "aetheris-pro" and the route translates them here.
CUSTOM_BASIC_MODEL=aetheris-basic-v1
CUSTOM_PRO_MODEL=aetheris-pro-v1

# Abort requests slower than this (ms)
CUSTOM_API_TIMEOUT_MS=60000

# Extra JSON fields merged into every POST body, e.g.
# CUSTOM_API_EXTRA_PARAMS={"top_p":0.9,"max_tokens":1024}
CUSTOM_API_EXTRA_PARAMS={}

# Only needed when LLM_PROVIDER=gemini. Free key (no credit card) at
# https://aistudio.google.com/ ("Get API key")
GOOGLE_GENERATIVE_AI_API_KEY=paste-your-key-here
GEMINI_BASIC_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.8-flash

# Only needed when LLM_PROVIDER=openai. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google sign-in (NextAuth) ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Add authorized redirect URI:
#      http://localhost:3000/api/auth/callback/google
#    (production: https://your-domain/api/auth/callback/google)
# 4. Paste the client ID + secret below, then restart the dev server.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=paste-your-client-id-here
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here
NEXTAUTH_SECRET=generate-one-with-the-command-above
NEXTAUTH_URL=https://www.aetherisai.me

# --- Strict server-side credit metering (Upstash Redis) ---
# Optional. Without these, the app uses client-side metering only.
# On Vercel: Storage/Marketplace -> add Upstash Redis -> Connect to the
# project (values are injected automatically) -> redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pro billing (PayPal subscriptions, $20/mo) ---
# 1. Create a REST app at https://developer.paypal.com (My Apps & Credentials)
#    and paste its sandbox credentials here. Use PAYPAL_ENV=live plus the
#    LIVE credentials only when taking real money.
# 2. The $20/mo product+plan is created automatically on first subscribe.
# 3. Browser key (public by design) for the PayPal checkout buttons:
#    NEXT_PUBLIC_PAYPAL_CLIENT_ID=<same client id as above>
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI support inbox (/api/support, Resend) ---
# 1. Sign up at https://resend.com, verify the aetherisai.me domain
#    (add their SPF/DKIM DNS records), create an API key.
# 2. GEMINI_API_KEY is optional: without it the existing
#    GOOGLE_GENERATIVE_AI_API_KEY is reused.
RESEND_API_KEY=
GEMINI_API_KEY=
# SUPPORT_MODEL=gemini-3.8-flash
