# ------------------------------------------------------------------
# Aetheris-owned API and model inference
# ------------------------------------------------------------------

# The public API is available at /api/v1. Assign api.aetherisai.me to the
# same Vercel project to use https://api.aetherisai.me/v1.
AETHERIS_API_RATE_LIMIT_PER_MINUTE=60

# Developer API (/api/v1) inference provider — any OpenAI-compatible endpoint.
# Keep the provider key server-side; never use NEXT_PUBLIC_ variables.
# Google's key does NOT serve /api/v1 — it powers the website chat only.
# OpenRouter example — paste your key, adjust models from openrouter.ai/models:
#   AETHERIS_INFERENCE_BASE_URL=https://openrouter.ai/api/v1
#   AETHERIS_INFERENCE_API_KEY=sk-or-v1-your-key
#   AETHERIS_MODELS_JSON=[{"id":"aetheris-basic","upstreamModel":"meta-llama/llama-3.3-70b-instruct","label":"Aetheris Basic","maxTokens":2048},{"id":"aetheris-asteroid","upstreamModel":"qwen/qwen3-235b-a22b","label":"Aetheris Asteroid","maxTokens":4096},{"id":"aetheris-pro","upstreamModel":"deepseek/deepseek-chat-v3-0324","label":"Aetheris Pro","maxTokens":4096}]
AETHERIS_INFERENCE_BASE_URL=https://inference.example.com/v1
AETHERIS_INFERENCE_API_KEY=
AETHERIS_INFERENCE_TIMEOUT_MS=120000

# Only configured aliases that are present on the provider's /models
# endpoint are returned by GET /v1/models.
AETHERIS_MODELS_JSON=[]

# --- Website chat inference only (server-only; separate from OAuth) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google sign-in (NextAuth) ---
GOOGLE_CLIENT_ID=paste-your-client-id-here
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=https://www.aetherisai.me

# --- Strict server-side credit metering / API-key storage (Upstash Redis) ---
# On Vercel, connect an Upstash Redis database to inject these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email sign-in and AI support reply delivery (Resend) ---
RESEND_API_KEY=

# --- Pro billing (PayPal subscriptions) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Card billing (Stripe subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
